{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "theme": "auto",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "autoMemoryDirectory": "~/.claude-private/memory",
  "skipDangerousModePermissionPrompt": true,
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "janet ~/.claude/statusline.janet"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read"
    ],
    "deny": [
      "Agent",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "allowedMcpServers": [
    {
      "serverUrl": "https://microsoft365.mcp.claude.com/*"
    }
  ]
}